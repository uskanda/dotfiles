{{- /*
  ~/.claude/settings.json (user 設定) — chezmoi 管理。
  端末差分が出やすい値は chezmoi のデータ経由で上書きする。

  既定値: model = "claude-opus-4-8[1m]"  （[1m] = 1M コンテキストウィンドウ）
  端末固有の上書き: ~/.config/chezmoi/chezmoi.toml に以下を書く

      [data.claude]
      model = "claude-sonnet-4-6"

  `dig` で未設定時に既定値へフォールバックするため、データ未定義でも安全に描画される。
*/ -}}
{{- $model := dig "claude" "model" "claude-opus-4-8[1m]" . -}}
{{- /* Claude Code runs command hooks through Git Bash on Windows; emit a
       bash-friendly "~" path there instead of a "C:\Users\..." path whose
       backslashes the shell would mangle. */ -}}
{{- $hook := printf "%s/.local/bin/claude-notify-hook" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $hook = "~/.local/bin/claude-notify-hook" -}}
{{- end -}}
{
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 30,
  "effortLevel": "xhigh",
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s notification" $hook | quote }}
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s stop" $hook | quote }}
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s done" $hook | quote }}
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true,
  "inputNeededNotifEnabled": true,
  "model": {{ $model | quote }},
  "remoteControlAtStartup": true,
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(glab auth *)",
      "Bash(glab variable *)",
      "Bash(crontab -l)",
      "Bash(ls -la)",
      "Bash(cat MEMORY.md)",
      "Bash(exit 1)",
      "Bash(bash -n *)",
      "Bash(bash --version)",

      "Bash(../venv/bin/pyinfra *)",
      "Bash(venv/bin/pyinfra *)",

      "Bash(venv/bin/python -m py_compile *)",

      "Bash(venv/bin/python -c ' *)",
      "Bash(../venv/bin/python -)",
      "Bash(venv/bin/pip install *)",
      "Bash(venv/bin/pip freeze *)",

      "Bash(apt-cache *)",
      "Bash(apt-get download *)",
      "Bash(dpkg -L fonts-noto-cjk)",
      "Bash(dpkg-deb -c *)",
      "Bash(fc-list*)",
      "Bash(grep -iE *)",
      "Bash(snap list *)",

      "Bash(command -v *)",
      "Bash(chezmoi --version)",
      "Bash(chezmoi source-path *)",

      "Bash(openspec --help)",
      "Bash(openspec show *)",
      "Bash(openspec archive *)",
      "Bash(openspec validate *)",

      "Read(//etc/**)",
      "Read(//usr/lib/**)",
      "Read(//usr/share/fonts/**)",
      "Read(//tmp/**)",
      "Read(//home/vscode/.claude/skills/mr/**)",
      "Read(//home/vscode/.claude/skills/mr-staging/**)",
      "Read(//home/vscode/.claude/skills/mr-qa/**)"
    ]
  },
  "theme": "auto"
}
