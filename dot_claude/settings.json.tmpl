{{- /*
  ~/.claude/settings.json (user 設定) — chezmoi 管理。
  端末差分が出やすい値は chezmoi のデータ経由で上書きする。

  既定値: model = "opus[1m]"  （[1m] = 1M コンテキストウィンドウ）
  世代を固定せずエイリアスで指定しているので、新しい Opus が出ても追随する。
  端末固有の上書き: ~/.config/chezmoi/chezmoi.toml に以下を書く

      [data.claude]
      model = "claude-sonnet-4-6"

  `dig` で未設定時に既定値へフォールバックするため、データ未定義でも安全に描画される。

  permissions.allow は複数端末の union で育てる。端末側で増えた分は
  chezmoi-merge スキル（または sync-claude-settings）で突合してここへ集約する。
  特定 devcontainer 固有の additionalDirectories（/workspace/... 配下）は端末を
  またいで意味を持たないので追跡しない。
*/ -}}
{{- $model := dig "claude" "model" "opus[1m]" . -}}
{{- /* Claude Code runs command hooks through Git Bash on Windows; emit a
       bash-friendly "~" path there instead of a "C:\Users\..." path whose
       backslashes the shell would mangle. */ -}}
{{- $hook := printf "%s/.local/bin/claude-notify-hook" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "windows" -}}
{{-   $hook = "~/.local/bin/claude-notify-hook" -}}
{{- end -}}
{
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 30,
  "effortLevel": "xhigh",
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s notification" $hook | quote }}
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s stop" $hook | quote }}
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": {{ printf "%s done" $hook | quote }}
          }
        ]
      }
    ]
  },
  "includeCoAuthoredBy": true,
  "inputNeededNotifEnabled": true,
  "model": {{ $model | quote }},
  "remoteControlAtStartup": true,
  "permissions": {
    "defaultMode": "auto",
    "additionalDirectories": [
      "/tmp"
    ],
    "allow": [
      "Bash(git *)",
      "Bash(gh auth *)",
      "Bash(gh repo *)",
      "Bash(glab auth *)",
      "Bash(glab variable *)",
      "Bash(glab api *)",
      "Bash(glab ci *)",
      "Bash(glab issue *)",
      "Bash(glab repo *)",
      "Bash(crontab -l)",
      "Bash(ls -la)",
      "Bash(cat MEMORY.md)",
      "Bash(exit 1)",
      "Bash(bash -n *)",
      "Bash(bash --version)",
      "Bash(claude --version)",
      "WebSearch",

      "Bash(../venv/bin/pyinfra *)",
      "Bash(venv/bin/pyinfra *)",
      "Bash(venv/bin/python -m py_compile *)",
      "Bash(venv/bin/python -c ' *)",
      "Bash(../venv/bin/python -)",
      "Bash(venv/bin/pip install *)",
      "Bash(venv/bin/pip freeze *)",
      "Bash(backend/venv/bin/python -)",
      "Bash(backend/venv/bin/python -c \"import pygments; print\\('pygments', pygments.__version__\\)\")",

      "Bash(apt-cache *)",
      "Bash(apt-get download *)",
      "Bash(dpkg -L fonts-noto-cjk)",
      "Bash(dpkg-deb -c *)",
      "Bash(fc-list*)",
      "Bash(grep -iE *)",
      "Bash(snap list *)",

      "Bash(command -v *)",
      "Bash(chezmoi --version)",
      "Bash(chezmoi source-path *)",

      "Bash(openspec --help)",
      "Bash(openspec --version)",
      "Bash(openspec show *)",
      "Bash(openspec list *)",
      "Bash(openspec new *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(openspec archive *)",
      "Bash(openspec validate *)",

      "Skill(list-unmerged-qa-changes)",
      "Skill(list-unmerged-qa-changes:*)",
      "Skill(merge_develop)",
      "Skill(merge_develop:*)",
      "Skill(mr-qa)",
      "Skill(mr-qa:*)",

      "Bash(shellcheck scripts/shift_ticket_reference_id.sh)",
      "Bash(grep -rn -E \"mypy|ruff\" .gitlab-ci.yml .github)",
      "Bash(find /workspace -maxdepth 3 -name \".pre-commit-config.yaml\")",
      "Bash(rm -rf frontend/src/components/ui/.claude && echo \"deleted\" && git status --porcelain)",
      "Bash(ls /Users/kanda/Repos/autoquarantine 2>/dev/null && echo \"---EXISTS---\" || echo \"---NOT ACCESSIBLE---\")",
      "Bash(timeout 30 glab api \"projects/:id/issues/386/notes\")",
      "Bash(OPENSPEC_TELEMETRY=0 openspec status --change \"record-log-added-history\")",
      "Bash(cat /proc/1/cgroup 2>/dev/null | head -5; echo \"--- env ---\"; env | grep -iE \"remote|codespace|devcontainer|container|CLAUDE|ANTHROPIC\" | sed 's/\\\\\\(KEY|TOKEN|SECRET\\\\\\)=.*/\\\\1=REDACTED/I')",

      "Read(//etc/**)",
      "Read(//usr/lib/**)",
      "Read(//usr/share/fonts/**)",
      "Read(//tmp/**)",
      "Read(//proc/1/**)",
      "Read(//Users/kanda/Repos/**)",
      "Read(//home/vscode/.claude/**)"
    ]
  },
  "theme": "auto",
  "tui": "fullscreen"
}
