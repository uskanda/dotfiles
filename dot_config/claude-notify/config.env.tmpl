{{- /*
  ~/.config/claude-notify/config.env — chezmoi 管理（テンプレート）。
  claude-notify / claude-notify-daemon / claude-notify-ntfy-sub が読み込む。

  値はリポジトリに入れず、各端末の ~/.config/chezmoi/chezmoi.toml に書く：

      [data.claudeNotify]
      token     = "..."                 # 案1: デーモン共有トークン（Mac/リモート共通）
      daemonUrl = ""                    # 空なら環境から自動導出
      ntfyUrl   = "https://ntfy.example.com"   # 案2: 空なら案2はスキップ
      ntfyTopic = "claude-xxxxxxxx"
      ntfyToken = ""                    # 案2: ntfy のトークン（任意）

  dig で未設定時は空にフォールバックするため、データ未定義でも安全に描画される。
  空＝その機能は無効（案2 は URL/Topic が空ならフォールバックを試みない）。
*/ -}}
# 案1: Mac 通知デーモン
CLAUDE_NOTIFY_TOKEN="{{ dig "claudeNotify" "token" "" . }}"
CLAUDE_NOTIFY_DAEMON_URL="{{ dig "claudeNotify" "daemonUrl" "" . }}"

# 案2: ntfy セルフホスト（空ならスキップ）
CLAUDE_NTFY_URL="{{ dig "claudeNotify" "ntfyUrl" "" . }}"
CLAUDE_NTFY_TOPIC="{{ dig "claudeNotify" "ntfyTopic" "" . }}"
CLAUDE_NTFY_TOKEN="{{ dig "claudeNotify" "ntfyToken" "" . }}"
