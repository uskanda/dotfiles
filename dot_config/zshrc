# nvm: インストールされている場合のみ読み込む
# (元は nvm のインストーラが各端末の zshrc に直接書き込んでいたものを、
#  存在チェック付きに直してここへ集約した)
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] && . "$NVM_DIR/nvm.sh"
[[ -s "$NVM_DIR/bash_completion" ]] && . "$NVM_DIR/bash_completion"

# pnpm: グローバルインストール先 (eas / tsc など) を PATH に通す。
# pnpm 本体は nvm 配下の node に同梱されているので、ここで見るのは
# `pnpm add -g` の出力先だけ。ディレクトリがある端末でのみ有効。
export PNPM_HOME="$HOME/.local/share/pnpm"
if [[ -d "$PNPM_HOME" ]] && [[ ":$PATH:" != *":$PNPM_HOME:"* ]]; then
  export PATH="$PNPM_HOME:$PATH"
fi

# pyenv / nvm / pnpm はいずれも PATH を通すだけなので AGENT_MODE ガードより上に置く。
# エージェント用シェルでも node や python が見えている方が都合がよい。

# CopilotやAIエージェント用の最低限の設定
if [[ "$AGENT_MODE" == "1" ]]; then
  export PS1='$ '   # プロンプト超シンプルに
  unalias -a        # すべてのalias無効
  # ここに、余計な機能をoffにする処理
  return
fi

# SSH 経由で Linux にログインした対話シェルでは tmux を自動起動する
# (AI 用シェルは上の AGENT_MODE ブロックで return 済みなので対象外)
if [[ -o interactive ]] && [[ "$OSTYPE" == linux* ]] && [[ -n "$SSH_CONNECTION" ]] && [[ -z "$TMUX" ]] && command -v tmux >/dev/null; then
  # 既存セッションがあれば attach、なければ新規作成。tmux 終了後はログアウトする
  tmux attach 2>/dev/null || tmux new-session
  exit
fi

