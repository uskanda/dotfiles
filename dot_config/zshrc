# set up ls aliases with color support
if ls --color=auto . >/dev/null 2>&1; then
  alias ls='ls --color=auto'
  alias la='ls --color=auto -a'
  alias ll='ls --color=auto -l -h'
  alias lal='ls --color=auto -a -l -h'
else
  alias ls='ls -G'
  alias la='ls -G -a'
  alias ll='ls -G -l -h'
  alias lal='ls -G -a -l -h'
fi

# Define a custom `cd` function that lists the contents of the directory after changing into it
function cd() {
  builtin cd "$@" || return
  # OSによってlsのオプションを切り替え
  if ls --color=auto . &>/dev/null; then
    ls -lh --color=auto
  else
    ls -lh -G
  fi
}

# exec ls if the buffer is empty
# This function will execute `ls` if the command line is empty when you press Enter.
function accept-line-or-ls() {
  if [[ -z $BUFFER ]]; then
    ls
    echo
    zle reset-prompt
  else
    zle accept-line
  fi
}
zle -N accept-line-or-ls
bindkey '^M' accept-line-or-ls

# スリープ復帰や SSH 切断で TUI アプリ (vim/tmux/less 等) が終了処理を飛ばすと、
# マウストラッキング (1000/1002/1003/1006) やフォーカスレポート (1004) が端末に
# 残り、以後マウス操作が [I や [<0;12;34M のような文字列として入力されてしまう。
# プロンプトのたびに解除しておけば、次のプロンプトで自動復旧する。
# ブラケットペースト (2004) は zsh 自身が管理しているので触らない。
function reset-terminal-reporting() {
  printf '\e[?1000l\e[?1002l\e[?1003l\e[?1004l\e[?1006l'
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd reset-terminal-reporting

